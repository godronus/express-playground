{
  "name": "express",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "start": "node --env-file=.env dist/index.js",
    "dev": "npm-run-all -p watch:css start:server",
    "start:server": "tsx watch --env-file=.env api/index.ts",
    "build": "npm-run-all -p build:css build:server",
    "build:server": "tsc",
    "build:css-debug": "npx @tailwindcss/cli -i ./tailwind.css -o ./public/styles.css",
    "build:css": "npx @tailwindcss/cli -i ./tailwind.css -o ./public/styles.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./tailwind.css -o ./public/styles.css --watch",
    "lint": "eslint --fix src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "@tailwindcss/cli": "^4.1.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.10",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.1",
    "eslint-plugin-format": "^1.0.1",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
