<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ESI poc</title>
    <!-- Add Tailwind CSS via CDN -->
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body class="bg-gray-100 text-gray-800">
    <header class="bg-orange-600 text-black p-6 text-center">
      <h1 class="text-4xl font-extrabold mb-2">Proof of Concept</h1>
      <p class="text-lg font-light">Edge Script Injection</p>
    </header>
    <main class="p-4 space-y-6">
      <h2 class="text-xl py-6">
        This home page will include ESI injected blocks displaying timestamps
        and route information:
      </h2>
      <div>
        <esi:include
          src="/block1"
          xmlns:esi="http://www.edge-delivery.org/esi/1.0"
        />
      </div>
      <div>
        <esi:include
          src="/block2"
          xmlns:esi="http://www.edge-delivery.org/esi/1.0"
        />
      </div>
    </main>
    <footer
      class="bg-{{color}}-100 text-black p-4 text-center fixed bottom-0 w-full"
    >
      <p>Rendered on origin at: <strong>{{timestamp}}</strong> </p>
    </footer>
  </body>
</html>
