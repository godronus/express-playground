<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>I'm a teapot</title>
    <!-- Add Tailwind CSS via CDN -->
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body class="bg-yellow-200 relative">
    <div class="min-h-screen p-4">
      <div class="flex items-center justify-center">
        <div id="error-content">
          <div class="relative content-size">
            <img
              src="/418.png"
              alt="Embedded Image"
              class="absolute top-0 left-0"
            />
          </div>
          <p class="text-2xl font-semibold text-gray-600 mt-4">
            I'm a teapot
          </p>
          <p class="text-gray-500 mt-2">
            The server refuses to brew coffee because it is a teapot.
          </p>
          <a
            href="/"
            class="mt-6 inline-block px-6 py-3 bg-green-600 text-white font-medium text-lg rounded hover:bg-green-700 transition"
          >
            Make a Coffee
          </a>
        </div>
      </div>
    </div>
    <footer
      class="absolute bottom-0 left-0 w-full text-gray-700 text-sm bg-yellow-200"
    >
      <div class="flex flex-wrap justify-center gap-2 sm:gap-4 p-2">
        <span class="flex items-center">
          Powered by FastEdge
        </span>
        <span class="px-3 sm-hide">•</span>
        <span class="flex justify-center items-center md-wrap sm-grow">
          <span class="pr-2">Trace-id:</span>
          <span class="text-center">{{trace_id}}</span>
        </span>
        <span class="px-3 md-hide">•</span>
        <div class="flex justify-center items-center sm-wrap md-grow">
          <span class="pr-2">Your IP:</span>
          <span class="text-center">{{your_ip}}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
